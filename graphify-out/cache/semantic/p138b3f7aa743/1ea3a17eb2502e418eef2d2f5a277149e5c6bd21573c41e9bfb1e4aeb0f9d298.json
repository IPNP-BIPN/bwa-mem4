{"nodes": [{"id": "readme", "label": "bwa-mem4 README", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_byte_identical_output", "label": "Byte-identical output to bwa-mem2 (acceptance criterion)", "file_type": "concept", "source_file": "README.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reproducing bytes means reproducing accidents: int read-pair id overflow at 2^23, float thresholds vs double, chain filter break skipping increment, unstable sorts with observable ties."}, {"id": "readme_bwa_mem2", "label": "bwa-mem2 (reference oracle)", "file_type": "concept", "source_file": "README.md", "source_location": "L4", "source_url": "https://github.com/bwa-mem2/bwa-mem2", "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fg_labs_bwa_mem3", "label": "fg-labs/bwa-mem3 (Nils Homer fork)", "file_type": "concept", "source_file": "README.md", "source_location": "L83", "source_url": "https://github.com/fg-labs/bwa-mem3", "captured_at": null, "author": null, "contributor": null}, {"id": "readme_giab_hg002_benchmark", "label": "GIAB HG002 30x benchmark (SE 8.04x, PE 8.81x at -t12)", "file_type": "concept", "source_file": "README.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_avx512_tier_host_dependence", "label": "AVX-512 tier worth depends on host (0.7% Zen 4 vs 6.8% Granite Rapids)", "file_type": "concept", "source_file": "README.md", "source_location": "L129", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zen 4 executes 512-bit ops as two 256-bit halves; Granite Rapids has the full datapath."}, {"id": "readme_bwa4_pcore_cap", "label": "BWA4_PCORE_CAP (E-cores used by default)", "file_type": "concept", "source_file": "README.md", "source_location": "L153", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uncapped 9.2% faster on real GIAB at -t16: a slow core doing work beats an idle one."}, {"id": "readme_bwa4_batch_overlap", "label": "BWA4_BATCH_OVERLAP (two batches in flight, off by default)", "file_type": "concept", "source_file": "README.md", "source_location": "L161", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buys at most ~1% wall for 0.8-2.3 GB more RSS; lowering -K is not equivalent because it moves the per-batch insert-size model."}, {"id": "readme_cross_platform_identity_caveat", "label": "bwa-mem2 x86 vs arm64 disagreement at -A 2 (issue #297)", "file_type": "concept", "source_file": "README.md", "source_location": "L187", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "update_a scaling law must hold; lone deviation at A=2 is an 8-bit/16-bit kernel selection artifact at bwamem.cpp:2302. Parity stated against arm64 build."}, {"id": "readme_long_reads_rammap", "label": "Long-read presets routed to rammap (not byte-identical)", "file_type": "concept", "source_file": "README.md", "source_location": "L218", "source_url": "https://github.com/jwanglab/rammap", "captured_at": null, "author": null, "contributor": null, "rationale": "bwa-mem2 itself warns it does not work well with long reads (fastmap.cpp:820); substitution is never silent (banner, @PG rammap). -x intractg stays on bwa path."}, {"id": "readme_longread_parity_sh", "label": "scripts/longread_parity.sh", "file_type": "concept", "source_file": "README.md", "source_location": "L243", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_verification_gates", "label": "Verification gates (check.sh, opt_fuzz, shape_fuzz, opt_parity, alt_parity, giab_publication, upstream_repros)", "file_type": "concept", "source_file": "README.md", "source_location": "L247", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A passing gate proves nothing until watched fail on a known bug; every identity bug lived where the gate was not looking."}, {"id": "readme_gpu_removed", "label": "No GPU: Metal backend removed (SW ~4% of WGS runtime)", "file_type": "rationale", "source_file": "README.md", "source_location": "L332", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seeding ~78% of whole-genome runtime; Amdahl caps SW offload at a few percent, and the Metal shader shipped a gap-opening bug (from H instead of M). Parked on branch gpu."}, {"id": "readme_output_formats_transcoding", "label": "BAM/CRAM by transcoding SAM through htslib", "file_type": "concept", "source_file": "README.md", "source_location": "L341", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Byte-identity is defined on SAM bytes, so binary formats must be a lossless re-encoding; CRAM reorders NM/MD tags."}, {"id": "readme_multi_format_feature", "label": "--features multi-format (bzip2, xz, zstd input)", "file_type": "concept", "source_file": "README.md", "source_location": "L365", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_upstream_bugs_not_fixed", "label": "Upstream bugs deliberately reproduced (#293, #278, #260; #269 crash handled)", "file_type": "concept", "source_file": "README.md", "source_location": "L402", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_workspace_layout", "label": "Cargo workspace layout (bwa-core, bwa-io, bwa-index, bwa-seed, bwa-chain, bwa-extend, bwa-neon, bwa-mem, bwa-cli, bwa-diff)", "file_type": "concept", "source_file": "README.md", "source_location": "L299", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme", "target": "docs_gpu_plan", "relation": "references", "c