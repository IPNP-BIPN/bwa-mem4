{"nodes": [{"id": "roadmap", "label": "ROADMAP (phase log and measurement journal)", "file_type": "document", "source_file": "ROADMAP.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each phase keeps its result including negatives so the same idea is never re-investigated twice."}, {"id": "roadmap_byte_identity_oracle", "label": "Byte-identity to bwa-mem2 2.3 oracle", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": "L4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acceptance criterion: index and SAM octet-identical; forbids pdqsort, float, approximate heuristics, half precision, reassociation."}, {"id": "roadmap_bwa_mem2", "label": "bwa-mem2 2.3", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_fg_labs_bwa_mem3", "label": "fg-labs/bwa-mem3 fork (nh13)", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_minibwa", "label": "minibwa", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not a valid target: uses minimap2 ksw2_extd2 and heuristics, output differs from bwa-mem2."}, {"id": "roadmap_minimap2", "label": "minimap2 -ax sr", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_hyalite", "label": "hyalite third-party SW oracle", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected as production kernel (striped intra-sequence, ~5x slower than inter-sequence NEON u8); kept as independent oracle; 0.4 adds asymmetric gap penalties."}, {"id": "roadmap_swbackend", "label": "SwBackend trait", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scalar is the source of truth; any backend implementing the trait inherits the whole acceptance battery without new harness."}, {"id": "roadmap_swbackendasync", "label": "SwBackendAsync submit/collect seam (#53)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_backend_barriers", "label": "Backend parity barriers (#54 tie rule, batch order invariance)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "assert_backend_tie_rule_matches_scalar and assert_backend_batch_order_invariant written before any GPU code; certify cross-thread regrouping."}, {"id": "roadmap_mate_rescue_kernel", "label": "Mate rescue NEON u8 kernel (batched_ksw_align2 / matesw)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cell count is fixed by bwa's algorithm; only per-cell cost can drop. Ceiling ~16 Gcell/s, 0.98 ops/cell; arithmetic is finished."}, {"id": "roadmap_xor_score_table", "label": "XOR-indexed score table with N_TARGET=12", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Encoding target N as 12 removes the N-vs-N collision so the per-row repair blend disappears (-7.2% kernel); ported to AVX2/SSE4.1 (#43, +17% on Zen 3) and AVX-512 (#44, +11.4% on Emerald Rapids)."}, {"id": "roadmap_usqadd_shareoe", "label": "USQADD fused add and shared qsub(h,oe) (#45)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "+10.3% kernel, -2.7% CPU; removes three register spills."}, {"id": "roadmap_zpad_column_regime", "label": "Padding-column regime (#47)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gain proportional to padded fraction: +7.4% at 49 bp, +1.6% at 150 bp."}, {"id": "roadmap_row_blocking", "label": "Two/four target-row blocking (ROWPAIR / ROWQUAD)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_extension_kernel", "label": "Banded extension kernel (batched_extend / ksw_extend2)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Latency-bound on the f->h->f carried chain, not ALU-bound."}, {"id": "roadmap_tight_band", "label": "Tight band from ungapped score (default since 2026-08-20)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lemma bounds useful band by (min_len*a - S)/(o_min+e_min); removes 91-97% banded cells; port of fork tight_band with lemma corrected three times; flips match vs fork on real reads."}, {"id": "roadmap_band_fast_regime", "label": "Fully in-band column regime", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unmasked columns where all active lanes share the band; 43.1% columns, -5.07% extension kernel."}, {"id": "roadmap_folded_prepass", "label": "Folded substitution prepass (#48B)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only lever removing a memory round-trip; +4-5% kernel; #48A/#48D were already applied by LLVM (merged monomorphizations)."}, {"id": "roadmap_signed_band_mask", "label": "Signed-space band mask (#48C)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_rowmax_u8", "label": "rowmax u8 on x86 u8 kernels (#46C)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_rescue_prune_filter", "label": "Exact k-mer mate rescue pruning filter", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Taken from fork #533/#541; proves 15.1% jobs fail on real GIAB; hit gate 400; ceiling ~2%."}, {"id": "roadmap_rescue_length_sort", "label": "Length-sort of rescue batch", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0.0% on untrimmed reads, -3.5% on fastp-trimmed variable-length reads."}, {"id": "roadmap_sort_dedup_patch", "label": "mem_sort_dedup_patch and observable ks_introsort permutation", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unstable sort permutation is visible in SAM; pdqsort would save 2.8% but is forbidden; indirect key sort with thread-local buffers recovers 1.9%."}, {"id": "roadmap_insert_into_settled", "label": "insert_into_settled (rescue no longer re-dedups)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deduped list is a fixed point; calls drop 1.42M to 92k; most of the 2026-10-31 PE gain."}, {"id": "roadmap_duplicate_work_elimination", "label": "Literally duplicated work (pure-function dedup)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two identical inputs are one computation and a copy; SA walk dedup (-10.6% get_sa_batch) and DP job dedup (-2.65 to -2.9% run)."}, {"id": "roadmap_get_sa_batch_window", "label": "get_sa_batch prefetch window 128", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SA resolution is memory-latency bound; window 32->128 on M4; flat on x86."}, {"id": "roadmap_lockstep_seeding", "label": "Lockstep SMEM seeding with startup MLP probe", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Width must equal cache misses in flight (MSHR); probed by pointer-chasing in cp_occ at startup; lockstep ate the gains of five memory-access techniques."}, {"id": "roadmap_seeding_prefetch", "label": "Seeding backward-search prefetch (phase 9d)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_compact_index", "label": "Compact in-memory index (32-byte checkpoints, 1-bit sa_ms_byte)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "File stays bwa-mem2 byte-identical; only the loaded form shrinks; RSS -20 to -37%."}, {"id": "roadmap_ram_phase_a", "label": "RAM phase A (.pac 2-bit reference, BWT via read())", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Peak 19.2 -> 11.2 GB; mmap+copy held BWT twice transiently."}, {"id": "roadmap_batch_overlap", "label": "Two batches in flight (BWA4_NO_BATCH_OVERLAP)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overlap explains the 2x RSS gap vs fork (#25); disabling costs 1.1% wall for -41% RSS; -K cannot be lowered without moving batch boundaries."}, {"id": "roadmap_stage_alloc_probe", "label": "BWA4_STAGE_ALLOC per-stage allocator probe", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Showed macOS RSS is an allocation ceiling; on Linux resident equals live (1.02x); allocator churn is 1.8% of busy so a per-worker arena is dead."}, {"id": "roadmap_scaling_model", "label": "Scaling model: efficiency = ALU(N) x random throughput(N)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Predicts scaling within 5 points; only reducing memory accesses or larger pages can move it; no aligner in the class scales better (62-67% at -t16)."}, {"id": "roadmap_sa_construction_backends", "label": "Suffix array construction backends (libsais C, libsais-rs, CaPS-SA)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A suffix array is unique so backend choice cannot touch output; C libsais serial default; OpenMP 1.68x at genome scale; CaPS-SA comparison-based degenerates on 4-symbol text without sentinels."}, {"id": "roadmap_libsais_c_omp_static", "label": "libsais-c-omp linked statically (OPENMP_STATIC)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Objection about a hidden dylib was testable via ldd and false; release asserts no shared OpenMP runtime."}, {"id": "roadmap_libdeflate", "label": "libdeflate as htslib deflate engine", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BAM overhead is compression not text parsing; -3.9% CPU, zero supply-chain cost."}, {"id": "roadmap_noodles_vs_htslib", "label": "noodles vs htslib BAM writer prototype", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct BAM-from-fields abandoned: writer is 9% occupied, max 0.7% CPU gain."}, {"id": "roadmap_pgo", "label": "PGO (profile-guided optimization)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apple Silicon-only lever; -0.6% on Ampere Altra and -3.3% on Zen 3 with release recipe, so release builds PGO only for Apple."}, {"id": "roadmap_x86_64_v3_artifact", "label": "bwa-mem4-x86-64-v3 second executable", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets compiler auto-vectorize scalar glue; 5.6-6.8% wall; x86-64-v4 loses (0.984x, 0.977x)."}, {"id": "roadmap_avx512_kernels", "label": "AVX-512BW kernels (#44)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 512 bits Golden Cove saturating ops fall on port 0; part B port arbitration measured 0.99x and reverted; tier worth 0.7% on Zen 4 vs 6.8% on Granite Rapids."}, {"id": "roadmap_intel_sde", "label": "Intel SDE emulation gate", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_metal_gpu_backend", "label": "Metal GPU backend (bwa-metal, bwa-gpu)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Byte-identical, -20% CPU but wall plateaus at ~1.54 s; abandoned on dev 2026-08-09, reopened 2026-08-29, moved back to gpu branch 2026-11-02."}, {"id": "roadmap_gpu_occupancy", "label": "GPU occupancy and batch size limit", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One job per thread means batch size is thread count; needs ~32k jobs; rescue submits ~72-180 so extension is the GPU path; host score2 costs as much as the kernel at scale."}, {"id": "roadmap_uchar4_packing", "label": "uchar4 four-jobs-per-thread packing on Metal", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tried and removed; probe later showed 0.97x; cause of 50 Gcell/s cap remains open."}, {"id": "roadmap_parabricks_dragen", "label": "Parabricks / DRAGEN framing", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Target is fastest bwa-mem2 byte-identical aligner, not DRAGEN; Parabricks is equivalent not identical."}, {"id": "roadmap_gpu_bwa_mem", "label": "GPU-BWA-MEM (ICS 2023)", "file_type": "paper", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_swipe", "label": "SWIPE (Rognes 2011) and SW state of the art", "file_type": "paper", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "3.41 cells/cycle/128 bits but score only; at equal output contract nothing published beats bwa-mem4."}, {"id": "roadmap_bwa_mem2_ipdps2019", "label": "bwa-mem2 IPDPS 2019 paper (Vasimuddin et al.)", "file_type": "paper", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_lemire_mlp", "label": "Lemire 2026 memory-level parallelism measurements", "file_type": "paper", "source_file": "ROADMAP.md", "source_location": null, "source_url": "https://lemire.me/blog/2026/07/25/memory-level-parallelism-amd-is-the-king/", "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_giab_gate", "label": "GIAB hap.py/vcfeval gate (phase 11)", "file_type": "rationale", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expresses byte identity in precision/recall: both arms 0.9899/0.9900."}, {"id": "roadmap_parity_gates", "label": "Parity gates (check.sh, opt_parity.sh, oracle_diff.sh, giab30x_pe.sh, docker_gates.sh)", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_reader_pipeline", "label": "FASTQ reader pipeline (parallel mate files, inflate thread, rapidgzip)", "file_