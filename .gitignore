# Rust build output
/target
# Alternate target dirs used when a measurement needs two builds of the same source (a probe
# feature, an instruction-set arm). The workflows create these by name, so they are ignored by name.
/target-*

# Reference clones (study material, gitignored; recreated by scripts/setup_reference.sh)
/reference/

# Transient working dirs: all derived indexes, generated FASTQ/FASTA, oracle/ours SAMs,
# time/RSS logs and concordance reports live here so they are never committed. `work*`
# covers per-phase scratch dirs (work, work8, ...).
/work/
/work*/
/scratch/

# Committed fixtures live under testdata/ and crates/*/tests/golden/ and are NOT ignored.
#
# One exception, because it is written INTO testdata/: the long-read path caches rammap's minimizer
# index beside the reference the first time `mem -x pacbio|ont2d` runs, so pointing a test at
# testdata/tiny leaves a `.mmi` there. It is a build artifact of the reference, derived and
# reproducible, never a fixture.
*.rammap.*.mmi

.DS_Store

# Editor/backup leftovers. One of these (`crates/bwa-chain/src/lib.rs.bak`) had been committed and
# was only noticed while auditing the tree before making the repository public.
*.bak
*.orig
*~
